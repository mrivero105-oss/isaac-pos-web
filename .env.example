# ISAAC POS - Entorno de Configuración Segura
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Isaac POS - Sistema de Punto de Venta"

# Seguridad y Rate Limiting (Opcional si se usa Upstash Redis en producción)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Pasarela de Pagos (Stripe API Keys - Cero manipulación de tarjetas en servidor)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Cloudflare Turnstile (Anti-Bot / Captcha silencioso)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Contacto / Leads Notification
NOTIFICATION_EMAIL="ventas@isaacpos.com"
